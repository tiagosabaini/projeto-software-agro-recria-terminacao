@startuml
entity "lotes" {
  * id : INTEGER <<PK>>
  --
  identificacao : TEXT
  fase_atual : TEXT
  categoria_animal : TEXT
  data_inicio : TEXT
  qtd_cabecas : INTEGER
  custo_bezerro_unitario : REAL
  custo_total_compra : REAL
  valor_venda_total : REAL
  total_arrobas_vendidas : REAL
  status : TEXT
  frigorifico_comprador : TEXT
  qtd_vendida_total : INTEGER
}

entity "despesas" {
  * id : INTEGER <<PK>>
  --
  lote_id : INTEGER <<FK>>
  categoria : TEXT
  valor : REAL
  observacao : TEXT
}

entity "pesagens" {
  * id : INTEGER <<PK>>
  --
  lote_id : INTEGER <<FK>>
  peso : REAL
  data : TEXT
}

entity "consumo_sal" {
  * id : INTEGER <<PK>>
  --
  lote_id : INTEGER <<FK>>
  data_registro : TIMESTAMP
  qtd_sacos : REAL
  peso_saco_kg : REAL
  dias : INTEGER
  qtd_bois : INTEGER
  gramas_cab_dia : REAL
}

entity "usuarios" {
  * id : INTEGER <<PK>>
  --
  nome : TEXT
  usuario : TEXT <<UNIQUE>>
  senha : TEXT
  nivel_acesso : TEXT
}

entity "cotacoes" {
  * id : INTEGER <<PK>>
  --
  frigorifico : TEXT <<UNIQUE>>
  preco : REAL
}

lotes ||--o{ despesas : possui
lotes ||--o{ pesagens : possui
lotes ||--o{ consumo_sal : consome
@enduml